# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Leave empty or set to 'embedded' to use the zero-setup persistent embedded MongoDB engine
# Or specify an external MongoDB connection string: mongodb://localhost:27017/messaging_platform
MONGODB_URI=embedded
DB_STORAGE_PATH=./data/db

# Background Worker Simulation (Stretch Goal)
ENABLE_WORKER_SIMULATION=false

# Logging
LOG_LEVEL=info
